# =========================================================
# MedArchive — пример переменных окружения.
# Скопируй файл в .env и подставь свои значения.
# Никогда не коммить заполненный .env в git.
# =========================================================

# --- App ---
APP_NAME=MedArchive
APP_ENV=development
DEBUG=True
# Используется FastAPI/middleware. В production обязателен secret из 32+ chars,
# не равный заводскому. Сгенерируй: `openssl rand -hex 32`. Если оставить
# дефолт при APP_ENV=production — приложение откажется стартовать.
SECRET_KEY=change-me-in-production-64-chars-min

# --- Database (MariaDB) ---
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=medarchive
DB_USER=medarchive
DB_PASSWORD=medarchive_dev_password
DB_ROOT_PASSWORD=root_dev_password

# --- Redis (общий кэш / брокер очередей в будущем) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT (используется с этапа 2) ---
JWT_SECRET=change-me-in-production-64-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption ---
# identity — заглушка (для тестов / dev без шифрования);
# aesgcm — AES-256-GCM + Argon2id KDF + двухслойная DEK/KEK архитектура.
# В production ОБЯЗАТЕЛЬНО aesgcm — иначе медданные хранятся в plaintext.
ENCRYPTION_PROVIDER=aesgcm

# Argon2id параметры (OWASP L1 по умолчанию: ~50мс на 3-CPU/8GB).
# 47104 KiB = 46 МБ. Можно поднять после benchmark на боевом железе.
ARGON2_MEMORY_KIB=47104
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# Redis для сессионных ключей шифрования (БЕЗ persistence — ключи только
# в памяти, чтобы при компрометации диска злоумышленник не получил их).
REDIS_KEYS_HOST=redis_keys
REDIS_KEYS_PORT=6379
REDIS_KEYS_DB=0

# --- Admin bootstrap ---
# Email, который при регистрации автоматически получит роль администратора.
# Сравнение case-insensitive. Оставь пустым, если не нужен автоматический
# первый админ (например, при втором деплое — назначай админов через SQL).
INITIAL_ADMIN_EMAIL=

# --- SMTP (отправка писем через Yandex по умолчанию) ---
# Получить пароль приложения: https://id.yandex.ru/security → "Пароли приложений"
# В dev/staging можно оставить SMTP_USER пустым — письма уйдут в логи
# (см. docker logs backend / mailer_worker, событие email.dev_fallback).
# В production пустой SMTP_USER блокирует старт приложения.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MedArchive
SMTP_USE_SSL=True
SMTP_TIMEOUT_SECONDS=30

# --- Frontend base URL (используется в шаблонах писем) ---
# В проде — публичный URL сайта (https://medarchive.example.com).
FRONTEND_BASE_URL=http://localhost

# --- ARQ (очередь фоновых задач) ---
# Использует общий Redis, но отдельную DB чтобы не пересекаться с кэшом.
ARQ_REDIS_DB=1

# --- AI assistant («Иван Иваныч», используется с этапа 5) ---
# Получить ключ можно бесплатно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30

# --- Telegram-бот (используется с этапа 6) ---
# Получить токен можно у @BotFather: /newbot.
# TELEGRAM_BOT_USERNAME — username бота без @ (для deep-link t.me/<username>?start=...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=medarchive_bot

# --- Admin Telegram bot (отдельный от пользовательского) ---
# Получить новый токен у @BotFather (другой бот, не тот же),
# узнать свой chat_id через @userinfobot. Пустой токен → admin-бот
# не запускается, уведомления молча игнорируются.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Sentry / GlitchTip (self-hosted error tracking) ---
# GlitchTip — open-source альтернатива Sentry, ~500MB RAM (полный Sentry
# съедает ~5GB). См. docs/DEPLOY.md, раздел GlitchTip. Пустой DSN —
# отключает SDK полностью (логи в stdout остаются).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- CORS ---
# CSV-список origin'ов, которым разрешён доступ к API из браузера.
# ⚠️ В production ОБЯЗАТЕЛЬНО замени localhost на реальный домен
# (https://medarchive.example.com). Если оставить localhost, любой
# другой сайт всё равно НЕ получит доступ (CORS заблокирует),
# но это даст ложное чувство безопасности — лучше явный whitelist.
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost/api
